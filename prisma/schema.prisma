generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}


/**
 * ADMIN MODEL
 */

model Admin {
  id String @id @default(cuid())

  /**
   * AUTH INFO
   */

  ownerName String

  mobile String @unique

  password String

  /**
   * DAIRY INFO
   */

  dairyName String

  village String

  taluka String

  district String

  state String

  /**
   * DAIRY SETTINGS
   */

  collectionType CollectionType

  milkType MilkType

  collectionShift CollectionShift

  paymentPeriod PaymentPeriod

  /**
   * RELATIONS
   */
  customers Customer[]
rateCharts RateChart[]
foodDealers FoodDealer[]
foodPurchases FoodPurchase[]  
foodSales FoodSale[]




  /**
   * TIMESTAMPS
   */

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

/**
 * CUSTOMER MODEL
 */

model Customer {
  id String @id @default(cuid())

  /**
   * CUSTOMER INFO
   */

  code Int

  name String

  mobile String

  address String?

  milkType MilkType

  /**
   * RELATION
   */

  adminId String

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  milkEntries MilkEntry[]

  foodEntries FoodEntry[]

  foodSales FoodSale[]


  /**
   * TIMESTAMPS
   */

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  /**
   * UNIQUE CONSTRAINTS
   */

  @@unique([adminId, code])
  @@unique([adminId, mobile])
}

/**
 * ENUMS
 */

enum CollectionType {
  FIXED_RATE
  FAT_BASED
  FAT_SNF_BASED
}

enum MilkType {
  COW
  BUFFALO
  MIX
}

enum CollectionShift {
  MORNING
  EVENING
  BOTH
}

enum PaymentPeriod {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
}

model MilkEntry {
  id String @id @default(cuid())

  /**
   * ENTRY INFO
   */

  date DateTime

  shift CollectionShift

  milkType MilkType

  quantity Float

  fat Float?

  snf Float?

  rate Float?

  totalAmount Float?

  /**
   * CUSTOMER RELATION
   */

  customerId String

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  /**
   * TIMESTAMPS
   */

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([date])
  @@index([customerId, date])
}

model FoodEntry {
  id String @id @default(cuid())

  /**
   * FOOD ENTRY INFO
   */

  date DateTime

  itemName String

  quantity Float

  amount Float

  totalAmount Float

  receiptNo String?

  paymentMode PaymentMode

  notes String?

  /**
   * CUSTOMER RELATION
   */

  customerId String

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  /**
   * TIMESTAMPS
   */

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  /**
   * INDEXES
   */

  @@index([customerId])
  @@index([date])
  @@index([customerId, date])
}

enum PaymentMode {
  CASH
  ONLINE
  UPI
  BANK_TRANSFER
  CREDIT
}

model RateChart {
  id String @id @default(cuid())

  /**
   * BASIC INFO
   */

  name String

  milkType MilkType

  category RateCategory

  chartType ChartType

  method RateMethod

  /**
   * BASE
   */

  baseRate Float @default(0)

  /**
   * RELATION
   */

  adminId String
  admin   Admin  @relation(fields: [adminId], references: [id], onDelete: Cascade)

  /**
   * STEPS
   */

  fatSteps FatStep[]

  snfSteps SnfStep[]

  /**
   * BONUS / PENALTY
   */

  rules BonusPenaltyRule[]

  /**
   * STATUS
   */

  isActive Boolean @default(false)

  effectiveFrom DateTime?
  /**
   * TIMESTAMPS
   */

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([adminId])
}

model FatStep {
  id String @id @default(cuid())

  /**
   * STEP CONFIG
   */

  startValue Float

  increment Float

  /**
   * RELATION
   */

  rateChartId String

  rateChart RateChart @relation(fields: [rateChartId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([rateChartId])
}

model SnfStep {
  id String @id @default(cuid())

  /**
   * STEP CONFIG
   */

  startValue Float

  increment Float

  /**
   * RELATION
   */

  rateChartId String

  rateChart RateChart @relation(fields: [rateChartId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([rateChartId])
}

model BonusPenaltyRule {
  id String @id @default(cuid())

  /**
   * RULE TYPE
   */

  axis RuleAxis

  /**
   * RANGE
   */

  fromValue Float

  toValue Float

  /**
   * BONUS / PENALTY
   */

  amount Float

  /**
   * RELATION
   */

  rateChartId String

  rateChart RateChart @relation(fields: [rateChartId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([rateChartId])
}

enum RateCategory {
  COLLECTION
  SALE
}



/*Who sells to dairy*/
model FoodDealer {
  id String @id @default(cuid())

  /**
   * DEALER INFO
   */

  code String

  name String

  phone String?

  address String?

  isActive Boolean @default(true)

  /**
   * ADMIN RELATION
   */

  adminId String

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

/**
   *  this relation will be used later -- for analytics part in dealers section 
   */
foodPurchases FoodPurchase[]

  /**
   * TIMESTAMPS
   */

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  /**
   * INDEXES
   */

  @@unique([adminId, code])

  @@index([adminId])

  @@index([name])

  @@index([phone])
}


/* What dairy purchased from dealer */
model FoodPurchase {
  id String @id @default(cuid())

  /**
   * OWNER
   */

  adminId String

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  /**
   * DEALER
   */

  dealerId String

  dealer FoodDealer @relation(fields: [dealerId], references: [id], onDelete: Restrict)

  /**
   * FOOD INFO
   */

  foodName String

  quantity Float

  remainingQuantity Float

  /**
   * RATES
   */

  buyRate Float

  sellRate Float

  /**
   * PAYMENTS
   */

  totalAmount Float

  amountPaid Float

  pendingAmount Float

  /**
   * PURCHASE DATE
   */

  purchaseDate DateTime

  /**
   * STATUS
   */

  isActive Boolean @default(true)

  foodSales FoodSale[]
  

  /**
   * TIMESTAMPS
   */

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  /**
   * INDEXES
   */

  @@index([adminId])

  @@index([dealerId])

  @@index([foodName])

  @@index([purchaseDate])

  @@index([remainingQuantity])
}


/* What dairy sold to farmers */
model FoodSale {
  id String @id @default(cuid())

  /**
   * OWNER
   */

  adminId String

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  /**
   * CUSTOMER
   */

  customerId String

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  /**
   * PURCHASE SOURCE
   */

  foodPurchaseId String

  foodPurchase FoodPurchase @relation(fields: [foodPurchaseId], references: [id], onDelete: Restrict)

  /**
   * FOOD INFO
   */

  foodName String

  quantity Float

  sellRate Float

  /**
   * PAYMENT
   */

  totalAmount Float

  amountPaid Float

  pendingAmount Float

  /**
   * PAYMENT MODE
   */

  isCashPayment Boolean @default(false)

  /**
   * SALE DATE
   */

  saleDate DateTime

  /**
   * STATUS
   */

  isActive Boolean @default(true)

  /**
   * TIMESTAMPS
   */

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  /**
   * INDEXES
   */

  @@index([adminId])

  @@index([customerId])

  @@index([foodPurchaseId])

  @@index([saleDate])
}

enum ChartType {
  POINT
  EXCEL
}

enum RateMethod {
  FAT_SNF
  FAT_ONLY
  FIXED
}

enum RuleAxis {
  FAT
  SNF
}
