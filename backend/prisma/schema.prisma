generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/**
 * ADMIN MODEL
 */

model Admin {
  id String @id @default(cuid())

  /**
   * AUTH INFO
   */

  ownerName String

  mobile String @unique

  password String

  /**
   * DAIRY INFO
   */

  dairyName String

  village String

  taluka String

  district String

  state String

  /**
   * DAIRY SETTINGS
   */

  collectionType CollectionType

  milkType MilkType

  collectionShift CollectionShift

  paymentPeriod PaymentPeriod

  /**
   * RELATIONS
   */
  customers     Customer[]
  foodDealers   FoodDealer[]
  foodPurchases FoodPurchase[]
  foodSales     FoodSale[]

  advances        Advance[]
  rateCharts      RateChart[]
  milkEntryAudits MilkEntryAudit[]
  billSettlements BillSettlement[]

  /**
   * TIMESTAMPS
   */

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

/**
 * CUSTOMER MODEL
 */

model Customer {
  id String @id @default(cuid())

  /**
   * CUSTOMER INFO
   */

  code Int

  name String

  mobile String

  address String?

  milkType MilkType

  isActive Boolean @default(true)

  /**
   * RELATION
   */

  adminId String

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  milkEntries MilkEntry[]

  foodEntries FoodEntry[]

  foodSales FoodSale[]

  advances Advance[]

  milkEntryAudits MilkEntryAudit[]

  billSettlements BillSettlement[]

  /**
   * TIMESTAMPS
   */

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  /**
   * UNIQUE CONSTRAINTS
   */

  @@unique([adminId, code])
  @@unique([adminId, mobile])
}

/**
 * ENUMS
 */

enum CollectionType {
  FIXED_RATE
  FAT_BASED
  FAT_SNF_BASED
}

enum MilkType {
  COW
  BUFFALO
  MIX
}

enum CollectionShift {
  MORNING
  EVENING
  BOTH
}

enum PaymentPeriod {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
}

model MilkEntry {
  id String @id @default(cuid())

  /**
   * ENTRY INFO
   */

  date DateTime

  shift CollectionShift

  milkType MilkType

  quantity Decimal @db.Decimal(10, 2)

  fat Decimal? @db.Decimal(5, 2)

  snf Decimal? @db.Decimal(5, 2)

  rate Decimal? @db.Decimal(12, 4)

  totalAmount Decimal? @db.Decimal(14, 2)

  /**
   * HISTORICAL SNAPSHOT & CORRECTION (Phase 2D)
   */
  calculationSnapshot Json?

  isCorrected Boolean @default(false)

  isReversed Boolean @default(false)

  isSettled Boolean @default(false)

  correctionReason String?

  reversalReason String?

  settlementEntry SettlementMilkEntry?

  /**
   * CUSTOMER RELATION
   */

  customerId String

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  /**
   * RATE CHART RELATION
   */

  rateChartId String?

  rateChart RateChart? @relation(fields: [rateChartId], references: [id], onDelete: Restrict)

  /**
   * TIMESTAMPS
   */

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([date])
  @@index([customerId, date])
  @@index([rateChartId])
}

model FoodEntry {
  id String @id @default(cuid())

  /**
   * FOOD ENTRY INFO
   */

  date DateTime

  itemName String

  quantity Float

  amount Float

  totalAmount Float

  receiptNo String?

  paymentMode PaymentMode

  notes String?

  /**
   * CUSTOMER RELATION
   */

  customerId String

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  /**
   * TIMESTAMPS
   */

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  /**
   * INDEXES
   */

  @@index([customerId])
  @@index([date])
  @@index([customerId, date])
}

enum PaymentMode {
  CASH
  ONLINE
  UPI
  BANK_TRANSFER
  CREDIT
}

/**
 * RATE CHART MODULE ENUMS
 */

enum RateCalculationMethod {
  RATE_TABLE
  BASE_DIFFERENTIAL
}

enum RateChartStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

/**
 * RATE CHART (A)
 * Common rate chart information for both Table Matrix & Base Differential methods
 */
model RateChart {
  id String @id @default(cuid())

  name     String
  milkType MilkType
  method   RateCalculationMethod
  status   RateChartStatus       @default(DRAFT)

  effectiveFrom DateTime
  effectiveTo   DateTime?

  // Excel / Matrix boundary metadata
  sourceFileName String?
  totalCells     Int?
  minFat         Decimal?  @db.Decimal(5, 2)
  maxFat         Decimal?  @db.Decimal(5, 2)
  minSnf         Decimal?  @db.Decimal(5, 2)
  maxSnf         Decimal?  @db.Decimal(5, 2)
  importedAt     DateTime?
  importedBy     String?

  /**
   * DAIRY / ADMIN RELATION
   */
  adminId String
  admin   Admin  @relation(fields: [adminId], references: [id], onDelete: Cascade)

  createdBy String?

  /**
   * METHOD SPECIFIC RELATIONS
   */
  rateTable    RateChartCell[]
  differential RateChartDifferential?

  /**
   * HISTORICAL AUDIT RELATION
   */
  milkEntries MilkEntry[]

  /**
   * TIMESTAMPS
   */
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([adminId, milkType, status])
  @@index([adminId, effectiveFrom, effectiveTo])
  @@index([adminId])
}

/**
 * RATE CHART CELL (B)
 * Stores 2D Matrix (Fat x SNF -> Rate) values for Method 1 (RATE_TABLE)
 */
model RateChartCell {
  id          String @id @default(cuid())
  rateChartId String

  fat  Decimal @db.Decimal(5, 2)
  snf  Decimal @db.Decimal(5, 2)
  rate Decimal @db.Decimal(10, 4)

  rateChart RateChart @relation(fields: [rateChartId], references: [id], onDelete: Cascade)

  @@unique([rateChartId, fat, snf])
  @@index([rateChartId, fat, snf])
}

/**
 * RATE CHART DIFFERENTIAL (C)
 * Stores Base & Differential parameters for Method 2 (BASE_DIFFERENTIAL)
 */
model RateChartDifferential {
  id          String @id @default(cuid())
  rateChartId String @unique

  baseFat  Decimal @db.Decimal(5, 2)
  baseSnf  Decimal @db.Decimal(5, 2)
  baseRate Decimal @db.Decimal(10, 4)

  fatDifferential Decimal @db.Decimal(10, 4)
  snfDifferential Decimal @db.Decimal(10, 4)

  differentialUnit Decimal @default(0.1) @db.Decimal(5, 3)

  // Bounds & guardrails
  minFat  Decimal? @db.Decimal(5, 2)
  maxFat  Decimal? @db.Decimal(5, 2)
  minSnf  Decimal? @db.Decimal(5, 2)
  maxSnf  Decimal? @db.Decimal(5, 2)
  minRate Decimal? @db.Decimal(10, 4)
  maxRate Decimal? @db.Decimal(10, 4)

  rateChart RateChart @relation(fields: [rateChartId], references: [id], onDelete: Cascade)
}

/**
 * Who sells to dairy
 */
model FoodDealer {
  id String @id @default(cuid())

  /**
   * DEALER INFO
   */

  code String

  name String

  phone String?

  address String?

  isActive Boolean @default(true)

  /**
   * ADMIN RELATION
   */

  adminId String

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  /**
   * this relation will be used later -- for analytics part in dealers section
   */
  foodPurchases FoodPurchase[]

  /**
   * TIMESTAMPS
   */

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  /**
   * INDEXES
   */

  @@unique([adminId, code])
  @@index([adminId])
  @@index([name])
  @@index([phone])
}

/**
 * What dairy purchased from dealer
 */
model FoodPurchase {
  id String @id @default(cuid())

  /**
   * OWNER
   */

  adminId String

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  /**
   * DEALER
   */

  dealerId String

  dealer FoodDealer @relation(fields: [dealerId], references: [id], onDelete: Restrict)

  /**
   * FOOD INFO
   */

  foodName String

  quantity Float

  remainingQuantity Float

  /**
   * RATES
   */

  buyRate Float

  sellRate Float

  /**
   * PAYMENTS
   */

  totalAmount Float

  amountPaid Float

  pendingAmount Float

  /**
   * PURCHASE DATE
   */

  purchaseDate DateTime

  /**
   * STATUS
   */

  isActive Boolean @default(true)

  foodSales FoodSale[]

  /**
   * TIMESTAMPS
   */

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  /**
   * INDEXES
   */

  @@index([adminId])
  @@index([dealerId])
  @@index([foodName])
  @@index([purchaseDate])
  @@index([remainingQuantity])
}

/**
 * What dairy sold to farmers
 */
model FoodSale {
  id String @id @default(cuid())

  /**
   * OWNER
   */

  adminId String

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  /**
   * CUSTOMER
   */

  customerId String

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  /**
   * PURCHASE SOURCE
   */

  foodPurchaseId String

  foodPurchase FoodPurchase @relation(fields: [foodPurchaseId], references: [id], onDelete: Restrict)

  /**
   * FOOD INFO
   */

  foodName String

  quantity Float

  sellRate Float

  /**
   * PAYMENT
   */

  totalAmount Float

  amountPaid Float

  pendingAmount Float

  /**
   * PAYMENT MODE
   */

  isCashPayment Boolean @default(false)

  /**
   * SALE DATE
   */

  saleDate DateTime

  /**
   * STATUS
   */

  isActive Boolean @default(true)

  settlementAllocations SettlementFeedAllocation[]

  /**
   * TIMESTAMPS
   */

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  /**
   * INDEXES
   */

  @@index([adminId])
  @@index([customerId])
  @@index([foodPurchaseId])
  @@index([saleDate])
}

model Advance {
  id String @id @default(cuid())

  adminId String

  customerId String

  advanceNumber String @unique

  originalAmount Decimal @db.Decimal(12, 2)

  recoveredAmount Decimal @default(0) @db.Decimal(12, 2)

  pendingAmount Decimal @db.Decimal(12, 2)

  status AdvanceStatus @default(ACTIVE)

  notes String?

  givenDate DateTime

  createdBy String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  /**
   * RELATIONS
   */

  admin Admin @relation(fields: [adminId], references: [id])

  customer Customer @relation(fields: [customerId], references: [id])

  transactions          AdvanceTransaction[]
  settlementAllocations SettlementAdvanceAllocation[]

  /**
   * INDEXES
   */

  @@index([adminId])
  @@index([customerId])
  @@index([status])
  @@map("advances")
}

model AdvanceTransaction {
  id String @id @default(cuid())

  advanceId String

  type AdvanceTransactionType

  amount Decimal @db.Decimal(12, 2)

  notes String?

  createdBy String?

  createdAt DateTime @default(now())

  settlementId String?
  settlement   BillSettlement? @relation(fields: [settlementId], references: [id], onDelete: Restrict)

  advance Advance @relation(fields: [advanceId], references: [id])

  @@index([advanceId])
  @@index([settlementId])
  @@map("advance_transactions")
}

enum AdvanceStatus {
  ACTIVE
  PARTIALLY_RECOVERED
  CLOSED
}

enum AdvanceTransactionType {
  ISSUED
  MANUAL_REPAYMENT
  BILL_SETTLEMENT_RECOVERY
}

/**
 * ========================================
 * PHASE 2D: MILK ENTRY AUDIT & INTEGRITY
 * ========================================
 */

enum MilkEntryAuditAction {
  CREATED
  CORRECTED
  REVERSED
  DELETED
}

model MilkEntryAudit {
  id String @id @default(cuid())

  milkEntryId String

  adminId String
  admin   Admin  @relation(fields: [adminId], references: [id], onDelete: Restrict)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  rateChartId String?

  action MilkEntryAuditAction

  originalValues Json?
  newValues      Json?

  reason      String?
  performedBy String?

  createdAt DateTime @default(now())

  @@index([milkEntryId])
  @@index([adminId])
  @@index([customerId])
  @@index([createdAt])
}

/**
 * ========================================
 * PHASE 2: BILLING SETTLEMENT MODELS
 * ========================================
 */

enum BillSettlementStatus {
  FINALIZED
  CANCELLED
}

model BillSettlement {
  id               String @id @default(cuid())
  settlementNumber String @unique

  adminId String
  admin   Admin  @relation(fields: [adminId], references: [id], onDelete: Restrict)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  paymentPeriod  PaymentPeriod?
  cycleStartDate DateTime
  cycleEndDate   DateTime

  totalLitres             Decimal @db.Decimal(12, 2)
  avgFat                  Decimal @db.Decimal(5, 2)
  avgSnf                  Decimal @db.Decimal(5, 2)
  grossMilkAmount         Decimal @db.Decimal(14, 2)
  previousFeedPending     Decimal @db.Decimal(14, 2)
  feedDeductionAmount     Decimal @db.Decimal(14, 2)
  remainingFeedBalance    Decimal @db.Decimal(14, 2)
  previousAdvancePending  Decimal @db.Decimal(14, 2)
  advanceDeductionAmount  Decimal @db.Decimal(14, 2)
  remainingAdvanceBalance Decimal @db.Decimal(14, 2)
  netPayableAmount        Decimal @db.Decimal(14, 2)

  paymentMode PaymentMode          @default(CASH)
  status      BillSettlementStatus @default(FINALIZED)
  remarks     String?
  settledBy   String?
  settledAt   DateTime             @default(now())

  milkEntries         SettlementMilkEntry[]
  feedAllocations     SettlementFeedAllocation[]
  advanceAllocations  SettlementAdvanceAllocation[]
  advanceTransactions AdvanceTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([adminId])
  @@index([customerId])
  @@index([adminId, customerId, cycleStartDate, cycleEndDate])
  @@index([adminId, settledAt])
  @@map("bill_settlements")
}

model SettlementMilkEntry {
  id String @id @default(cuid())

  settlementId String
  settlement   BillSettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)

  milkEntryId String    @unique
  milkEntry   MilkEntry @relation(fields: [milkEntryId], references: [id], onDelete: Restrict)

  collectionDate DateTime
  shift          CollectionShift
  milkType       MilkType
  quantity       Decimal         @db.Decimal(10, 2)
  fat            Decimal?        @db.Decimal(5, 2)
  snf            Decimal?        @db.Decimal(5, 2)
  rate           Decimal         @db.Decimal(12, 4)
  totalAmount    Decimal         @db.Decimal(14, 2)

  createdAt DateTime @default(now())

  @@index([settlementId])
  @@map("settlement_milk_entries")
}

model SettlementFeedAllocation {
  id String @id @default(cuid())

  settlementId String
  settlement   BillSettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)

  foodSaleId String
  foodSale   FoodSale @relation(fields: [foodSaleId], references: [id], onDelete: Restrict)

  originalSaleAmount     Decimal @db.Decimal(14, 2)
  previousPendingAmount  Decimal @db.Decimal(14, 2)
  allocatedAmount        Decimal @db.Decimal(14, 2)
  remainingPendingAmount Decimal @db.Decimal(14, 2)

  createdAt DateTime @default(now())

  @@unique([settlementId, foodSaleId])
  @@index([settlementId])
  @@index([foodSaleId])
  @@map("settlement_feed_allocations")
}

model SettlementAdvanceAllocation {
  id String @id @default(cuid())

  settlementId String
  settlement   BillSettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)

  advanceId String
  advance   Advance @relation(fields: [advanceId], references: [id], onDelete: Restrict)

  originalAdvanceAmount  Decimal @db.Decimal(14, 2)
  previousPendingAmount  Decimal @db.Decimal(14, 2)
  allocatedAmount        Decimal @db.Decimal(14, 2)
  remainingPendingAmount Decimal @db.Decimal(14, 2)

  createdAt DateTime @default(now())

  @@unique([settlementId, advanceId])
  @@index([settlementId])
  @@index([advanceId])
  @@map("settlement_advance_allocations")
}
